FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// NASA TMR freestream for SST:
//   omega_inf = 1e-6 * rho_inf * a_inf^2 / mu_inf = 1e-6 * a_inf^2 / nu_inf = 1215.8 1/s
// (a_inf = 165.66 m/s, nu_inf = 2.257e-5 m2/s with Sutherland).
// MOSE input: omega = rho_inf * omega_inf = 248.1 (density-weighted).

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 1215.8;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 1215.8;
    }
    outlet
    {
        type            zeroGradient;
    }
    bottomWall
    {
        // omega wall condition, selected by ./variant.sh: system/omegaFaceBC
        // (asymptotic, MOSE's face condition) or omegaWallFunction (wallfunction)
        #include "$FOAM_CASE/system/omegaFaceBC"
        value           uniform 1e9;
    }
    topWall
    {
        #include "$FOAM_CASE/system/omegaFaceBC"
        value           uniform 1e9;
    }
    symTop
    {
        type            symmetry;
    }
    frontAndBack
    {
        type            empty;
    }
}

