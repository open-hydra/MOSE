FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// M = 5, T = 68.3 K  ->  U = 5*sqrt(1.4*287*68.3) = 828.29 m/s

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (828.29 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (828.29 0 0);
    }
    outlet
    {
        type            zeroGradient;
    }
    bottomWall
    {
        type            noSlip;
    }
    topWall
    {
        type            noSlip;
    }
    symTop
    {
        type            symmetry;
    }
    frontAndBack
    {
        type            empty;
    }
}

